# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave every POSTGRES_* variable unset to fall back to a local SQLite file.
POSTGRES_DB=habot
POSTGRES_USER=habot
POSTGRES_PASSWORD=habot_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Alternatively, a single URL takes precedence over the variables above:
# DATABASE_URL=postgres://habot:habot_password@localhost:5432/habot

# Mock payment gateway
PAYMENT_GATEWAY_BASE_URL=https://mock-pay.habotconnect.test/v1
PAYMENT_GATEWAY_API_KEY=sk_test_habot_mock
PAYMENT_GATEWAY_TIMEOUT=5.0
PAYMENT_GATEWAY_MAX_RETRIES=2
PAYMENT_WEBHOOK_SECRET=whsec_habot_mock_secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# Business rules
BOOKING_MIN_DURATION_MINUTES=30
BOOKING_MAX_DURATION_MINUTES=240
BOOKING_MAX_ADVANCE_DAYS=180

# Logging
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
# Set to DEBUG to print every SQL statement (used to demonstrate the N+1 fix).
SQL_LOG_LEVEL=WARNING
